# Rapidd configuration — copy to .env, or just start the API: without configuration it opens the
# setup wizard in the browser. Only DATABASE_URL is required; the comments name the defaults.
# Variables set in the real environment win over this file.

# ══════════════════════════════════════════════════════════
#  SERVER
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
# development | production | test — production enforces secrets, strict CORS and Secure cookies
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Externally visible base URL of this API — used for OIDC callback URLs.
# REQUIRED in production for SSO (redirect) login; development derives it from the request.
PUBLIC_URL=
# Which proxies may set X-Forwarded-*: their addresses (10.0.0.0/8,127.0.0.1 — or private: this
# machine and private networks; cloudflare: Cloudflare's servers) | a hop count (1: one proxy at a
# private address; 1,203.0.113.0/24: at those addresses) | true (every proxy) | false.
# Behind Cloudflare: private,cloudflare. Unset: every proxy — set it in production.
TRUST_PROXY=
# Max request body size in bytes (default 1048576)
BODY_LIMIT=
# Incoming header whose value is reused as the request id (default x-request-id)
REQUEST_ID_HEADER=

# ── Health & shutdown ─────────────────────────────────────
# GET /health and /health/ready (set false to disable)
HEALTH_ENABLED=true
# On SIGTERM: keep serving this long with readiness 503 so load balancers drain (ms)
SHUTDOWN_DELAY_MS=0
# On SIGTERM: max time for in-flight requests to finish before a hard exit (ms)
SHUTDOWN_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════
#  DATA STORES
# ══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# REQUIRED. postgresql://, postgres://, mysql:// or mariadb:// — URL-encode special characters
# in the password (@ → %40). Parameters: schema (PostgreSQL), connection_limit, pool_timeout,
# sslmode / sslaccept, ... — see the Configuration wiki
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
# Admin connection (bypasses RLS) for sign-in lookups; defaults to DATABASE_URL
DATABASE_URL_ADMIN=
# Auto-detected from URL; set to "postgresql" or "mysql" to override
DATABASE_PROVIDER=

# ── Redis ─────────────────────────────────────────────────
# Optional: with Redis, sessions and rate limits are shared between instances and survive
# restarts; without it they live in process memory.
# Either a URL (rediss:// for TLS) ...
REDIS_URL=
# ... or host/port
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# TLS for REDIS_HOST connections (managed Redis on Azure/AWS/GCP)
REDIS_TLS=false
# Database numbers for rate limits and sessions
REDIS_DB_RATE_LIMIT=0
REDIS_DB_AUTH=1

# ══════════════════════════════════════════════════════════
#  SECURITY
# ══════════════════════════════════════════════════════════

# ── Access control ────────────────────────────────────────
# Models without an entry in src/config/acl.ts: allow (default) | deny
ACL_DEFAULT=allow
# Row-level security (PostgreSQL): the variables of config/rls.json, set in every transaction.
# On unless false; MySQL and MariaDB have no row-level security
RLS_ENABLED=
# Namespace of the variables: app gives app.current_user_id (default: app)
RLS_NAMESPACE=app

# ── Browser access ────────────────────────────────────────
# Comma-separated list of allowed origins for CORS, * allows all. A bare host also allows its
# subdomains and any scheme/port; https://host:port entries require that scheme and port.
ALLOWED_ORIGINS=*
# Extra request headers browsers may send (comma-separated), e.g. X-Tenant-Id
CORS_ALLOWED_HEADERS=
# Signs cookies, the auth cookies included (unset: cookies are not signed)
COOKIE_SECRET=your-cookie-secret-here
# SameSite policy for cookies: strict (default) | lax | none
# 'none' requires Secure cookies (production). Auth cookies use AUTH_COOKIE_SAME_SITE.
COOKIE_SAME_SITE=strict

# ── Rate limiting ─────────────────────────────────────────
# Per client IP; per-path limits in config/rate-limit.json. Shared through Redis when configured.
RATE_LIMIT_ENABLED=true
# Rate limit window in ms (default: 15min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ══════════════════════════════════════════════════════════
#  API
# ══════════════════════════════════════════════════════════

# ── Queries & responses ───────────────────────────────────
# Max results per query
API_RESULT_LIMIT=500
# Max rows loaded per included list relation (0 = no cap; defaults to API_RESULT_LIMIT)
API_INCLUDE_RESULT_LIMIT=500
# Pagination mode: "offset" (limit/offset) or "page" (page/pageSize)
PAGINATION_MODE=offset
# Max comma-separated / boolean-group leaf conditions in one filter (?q=)
MAX_FILTER_CONDITIONS=100
# Max elements in an array filter, e.g. id=[1,2,3]
MAX_FILTER_ARRAY_LENGTH=1000
# Timezone (IANA) for date-only filters like on:2024-06-15 — default: the server's timezone
API_TIMEZONE=
# Language when the request names none (must have a locales/<lang>.json)
DEFAULT_LANGUAGE=en_US

# ── Outgoing requests ─────────────────────────────────────
# ApiClient calls to the services in config/app.json: timeout (ms) and retries — every
# method; "retry": false on a service or endpoint in config/app.json turns them off there
REQUEST_TIMEOUT=10000
API_MAX_RETRIES=2

# ══════════════════════════════════════════════════════════
#  OPERATIONS
# ══════════════════════════════════════════════════════════

# ── Logging ───────────────────────────────────────────────
# essential (default), fine, or finest (finest logs bodies — credentials are redacted)
LOG_LEVEL=essential
# text (default) or json (one object per line, for log aggregators)
LOG_FORMAT=text
# Directory for log files (default: logs/). Empty disables file logging (containers: log to stdout).
LOG_DIR=logs
# Fastify's own per-request logger, in addition to Rapidd's (default: false)
FASTIFY_LOGGER=false

# ── Setup wizard ──────────────────────────────────────────
# While the API cannot start (no DATABASE_URL, Prisma client not generated, ...), `npm run dev`
# and `npm start` serve a setup wizard instead — open the link printed in the console.
# auto (default) | on — at every start, before the API (to change services, rate limits, ...;
# set it back afterwards) | off — exit with the error instead (orchestrated deployments).
# `npm run setup` opens the wizard any time, whatever this says.
SETUP_WIZARD=auto
# The wizard's access password. Leave it empty: every start creates a random one and prints it
# with the wizard link in the console. Set your own (16+ characters) only when a script drives
# the setup (Authorization: Bearer <SETUP_PASSWORD>), e.g. in automated installs.
SETUP_PASSWORD=
# ENV_FILE — the env file to load and edit (default: .env). Set it in the real environment,
# not in this file, e.g. ENV_FILE=/app/data/.env in containers.

# ══════════════════════════════════════════════════════════
#  AUTHENTICATION
# ══════════════════════════════════════════════════════════

# ── Sign-in providers ─────────────────────────────────────
# Identity providers, in order (password logins try them in this order):
#   local  — your user table (default)
#   ldap   — LDAP / Active Directory (npm install ldapts)
#   oidc   — OpenID Connect / OAuth2: Entra ID, Keycloak, Okta, Google, ...
#   saml   — SAML 2.0 single sign-on: Entra ID, ADFS, Okta, Keycloak, Shibboleth, ...
#            (npm install @node-saml/node-saml)
#   webdav — credentials checked against a WebDAV server (Nextcloud, ...)
#   none   — no sign-in: every request is anonymous ({ id: null }) and src/config/acl.ts
#            decides what it may do — e.g. behind a gateway that authenticates already
# Each provider has its section below. Several providers of one kind, or custom logic:
# src/config/auth.ts
AUTH_PROVIDERS=local

# ── Tokens ────────────────────────────────────────────────
# JWT secrets are auto-generated in development; REQUIRED in production
JWT_SECRET=
JWT_REFRESH_SECRET=
# JWT access token expiry: a number and a unit — 15m, 1h, 1d (s, m, h, d, w); a bare number is seconds
AUTH_ACCESS_TOKEN_EXPIRY=1d
# JWT refresh token expiry — refresh tokens rotate on every use (default 7d)
AUTH_REFRESH_TOKEN_EXPIRY=30d

# ── Sessions ──────────────────────────────────────────────
# redis or memory (default: redis when REDIS_URL/REDIS_HOST is set, else memory)
AUTH_SESSION_STORAGE=
# Session idle timeout in seconds (default: 24h)
AUTH_SESSION_TTL=86400
# Absolute session lifetime in seconds — re-login required after it (0 = unlimited)
AUTH_SESSION_MAX_AGE=0

# ── Session transport ─────────────────────────────────────
# How clients send the session, comma-separated: bearer, basic, cookie, header (default: bearer)
AUTH_STRATEGIES=bearer
# Cookie name for the cookie strategy (default: token; refresh cookie: <name>_refresh).
# Cookies are signed with COOKIE_SECRET (SECURITY → Browser access).
AUTH_COOKIE_NAME=token
# Cookie domain (default: unset — current host only). Use ".example.com" for cross-subdomain.
AUTH_COOKIE_DOMAIN=
# Cookie SameSite attribute: strict (default), lax, none
AUTH_COOKIE_SAME_SITE=strict
# Cookie Secure flag: true/false (default: true in production)
AUTH_COOKIE_SECURE=
# Header name for the header strategy (default: X-Auth-Token)
AUTH_CUSTOM_HEADER=X-Auth-Token

# ── User table ────────────────────────────────────────────
# Your users — for local sign-in, and to link external identities to rows
# Auto-detected (user, users, account, accounts); set to override (e.g., "accounts")
DB_USER_TABLE=
# Auto-detected; set to override (e.g., "hash")
DB_USER_PASSWORD_FIELD=
# Auto-detected from unique string fields; comma-separated (default: email)
DB_USER_IDENTIFIER_FIELDS=
# bcrypt cost, 4–31 — each step doubles the time a password check takes (10–12 is usual)
AUTH_SALT_ROUNDS=10

# ── External identities ───────────────────────────────────
# For ldap, oidc, saml and webdav users. Link IdP/directory identities to user-table rows:
# email (default) | username | subject | <userField>:<identityAttribute> | false (users are
# their claims: id, email, name, groups, roles)
AUTH_LINK=email
# Where browser (single sign-on) logins land when no ?redirect= is given — e.g. your SPA's URL
AUTH_LOGIN_REDIRECT=/

# ── LDAP / Active Directory (AUTH_PROVIDERS=ldap) ─────────
# One or more servers (failover), ldaps:// recommended
LDAP_URL=ldaps://dc1.corp.example.com,ldaps://dc2.corp.example.com
# Search-then-bind (recommended): a service account finds the user
LDAP_BIND_DN=CN=svc-api,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=corp,DC=example,DC=com
# Default matches sAMAccountName, userPrincipalName, uid and mail
LDAP_SEARCH_FILTER=
# Direct bind instead (no service account): {{username}}@corp.example.com
LDAP_BIND_TEMPLATE=
# Active Directory nested group membership
LDAP_NESTED_GROUPS=false
# Servers without memberOf: search groups instead
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER=
LDAP_STARTTLS=false
LDAP_TLS_CA_FILE=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT=5000

# ── OpenID Connect / OAuth2 (AUTH_PROVIDERS=oidc) ─────────
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# Keycloak: https://sso.example.com/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Expected "aud" of bearer access tokens (default: OIDC_CLIENT_ID), comma-separated
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
# Scopes every bearer token must carry
OIDC_REQUIRED_SCOPES=
# Default: <PUBLIC_URL>/auth/oidc/callback (PUBLIC_URL: SERVER → Server)
OIDC_REDIRECT_URI=
# Stable user id claim (Entra ID: oid)
OIDC_SUBJECT_CLAIM=sub
# Accept the IdP's access tokens as bearer tokens / enable browser login
OIDC_ACCEPT_BEARER=true
OIDC_LOGIN=true
# Validate opaque (non-JWT) tokens via RFC 7662 introspection
OIDC_INTROSPECTION=false

# ── SAML 2.0 (AUTH_PROVIDERS=saml) ────────────────────────
# The identity provider's metadata: a URL (https, read again daily) —
# Entra ID: https://login.microsoftonline.com/<tenant-id>/federationmetadata/2007-06/federationmetadata.xml?appid=<app-id>
SAML_IDP_METADATA_URL=
# — or a file (the setup wizard saves an upload here)
SAML_IDP_METADATA_FILE=config/saml-idp-metadata.xml
# A federation's metadata with several identity providers: the entity id of yours
SAML_IDP_ENTITY_ID=
# This API at the identity provider. Defaults: <PUBLIC_URL>/auth/saml/metadata and
# <PUBLIC_URL>/auth/saml/callback (where the IdP posts sign-ins; Entra ID: Reply URL)
SAML_SP_ENTITY_ID=
SAML_CALLBACK_URL=
# Default: unspecified (the IdP's choice). The NameID is the user's id without a user-table
# row — ask for urn:oasis:names:tc:SAML:2.0:nameid-format:persistent if the IdP sends transient ones
SAML_NAMEID_FORMAT=
# Attribute names — found by default for Entra ID, ADFS, Okta, Keycloak, Shibboleth, Google
SAML_ATTRIBUTE_EMAIL=
SAML_ATTRIBUTE_NAME=
SAML_ATTRIBUTE_USERNAME=
SAML_ATTRIBUTE_GROUPS=
SAML_ATTRIBUTE_ROLES=
# A valid IdP signature on the response or the assertion is always required; these require a specific one
SAML_WANT_ASSERTIONS_SIGNED=false
SAML_WANT_RESPONSE_SIGNED=false
# PEM files: sign requests and decrypt encrypted assertions, for IdPs that want either
SAML_SP_PRIVATE_KEY_FILE=
SAML_SP_CERT_FILE=

# ── WebDAV (AUTH_PROVIDERS=webdav) ────────────────────────
# {{username}} is URL-encoded, e.g. https://cloud.example.com/remote.php/dav/files/{{username}}/
WEBDAV_URL=
WEBDAV_TIMEOUT=5000